{
  "name": "mission-control",
  "version": "0.0.1",
  "description": "Control plane for delegated agent runs",
  "type": "module",
  "bin": { "mc": "dist/mc.js" },
  "files": ["dist"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "mc": "node src/mc.ts",
    "build": "tsc -p tsconfig.build.json",
